  patch -p1 << 'EOF'
From 439deb66b6a446d8ec581fcb0cb7207d4b17d944 Mon Sep 17 00:00:00 2001
From: Ben Hutchings <benh@debian.org>
Date: Fri, 6 Nov 2026 12:33:42 +0000
Subject: [PATCH] Do not use dpkg-query --search to find the kernel package

Commit 9186319d71aa "Defer if selected kernel is not fully
"installed"" introduced the function get_kernel_status to check that a
selected kernel version has been fully installed.

This runs "dpkg-query --search" to find the owner of the kernel image
in /boot.  This no longer works with Debian official kernel packages
since the kernel image is initially installed under /usr/lib/modules
and then linked or copied to /boot.

Replace this with a loop over possible kernel package names to find
which one is either partly or fully installed.

Closes: #1148115
---
 functions        | 30 ++++++++++++++++++++----------
 2 files changed, 24 insertions(+), 10 deletions(-)

diff --git a/functions b/functions
index 7bb654b..4a1351b 100644
--- a/functions
+++ b/functions
@@ -600,17 +600,27 @@ get_kernel_status() {
 	# get_kernel_status(query_ver)
 	# return the dpkg package status of kernel version $query_ver
 	local query_ver="$1"
-	local ver path pkg
-	linux-version list --paths | while read -r ver path; do
-		if linux-version compare "$ver" eq "$query_ver"; then
-			pkg=$(
-				LANG=C.UTF-8 dpkg-query --search "$path" 2>/dev/null |
-				awk -F ": " -v path="$path" '$2==path { print $1; }'
-			)
-			LANG=C.UTF-8 dpkg-query --show --showformat '${db:Status-Status}' "$pkg"
-			break
-		fi
+	local pkg status
+
+	# The kernel could be installed from any of these packages.
+	# We can't use dpkg-query to find out which, because it might
+	# not directly install /boot/vmlinuz-${query_ver} (Debian bug
+	# #1148115).  Instead, query the status of each package and
+	# report the first that is partly or fully installed.
+	for pkg in "linux-image-${query_ver}" \
+		   "linux-image-unsigned-${query_ver}" \
+		   "linux-image-${query_ver}-unsigned"; do
+		status="$(LANG=C.UTF-8 dpkg-query --show --showformat '${db:Status-Status}' "$pkg" 2>/dev/null)" || continue
+		case "$status" in
+			not-installed | config-files)
+				# Was installed, but has been removed
+				continue
+				;;
+		esac
+		printf '%s' "$status"
+		return
 	done
+	printf not-installed
 }
 
